{
  "manifest_version": 3,
  "name": "HaDeS Shortcuts — Productivity New Tab & Command Center",
  "version": "6.0.0",
  "description": "Ultra-aesthetic cyberpunk startpage, glassmorphism bento grid, offline AI semantic search, focus soundscapes and productivity tools.",
  "default_locale": "en",
  "icons": {
    "16": "iconos/pwa-192.png",
    "48": "iconos/pwa-192.png",
    "128": "iconos/pwa-512.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "js/sw-extension.js"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "topSites",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://images.unsplash.com/*",
    "https://hn.algolia.com/*",
    "https://api.allorigins.win/*",
    "https://www.google.com/*",
    "https://www.cloudflare.com/*",
    "https://1.1.1.1/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}